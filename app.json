{
  "expo": {
    "name": "Trace Finance",
    "slug": "trace-mobile-app-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/trace-icon.png",
    "scheme": "tracemobileappexpo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.brayan200318.trace-mobile-app-expo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#009689",
        "foregroundImage": "./assets/trace-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brayan200318.tracemobileappexpo",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#009689",
          "image": "./assets/trace-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-image",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/font/Satoshi-Light.otf",
            "./assets/font/Satoshi-Regular.otf",
            "./assets/font/Satoshi-Medium.otf",
            "./assets/font/Satoshi-Bold.otf",
            "./assets/font/Satoshi-Black.otf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trace usa tus fotos para adjuntar facturas y recibos a tus gastos."
        }
      ],
      "expo-localization",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c1859b6-6e89-4321-b63a-83ee8e83084c"
      }
    }
  }
}
